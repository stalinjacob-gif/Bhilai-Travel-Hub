{"name":"bhilai-travel-hub","version":"0.1.0","private":true,"engines":{"node":">=22.5"},"scripts":{"start":"node --disable-warning=ExperimentalWarning server/index.js","prestart":"npm run build","dev":"concurrently -k -s first \"npm:dev:server\" \"npm:dev:client\"","dev:server":"node --disable-warning=ExperimentalWarning --watch server/index.js","dev:client":"vite --config vite.config.js --host 127.0.0.1","build":"vite build --config vite.config.js","cf:dev":"wrangler dev","cf:deploy":"npm run build && wrangler deploy","test":"NODE_ENV=test node --disable-warning=ExperimentalWarning --test tests/api.test.js"},"dependencies":{"cookie-parser":"^1.4.7","express":"^5.1.0","express-rate-limit":"^8.0.0","helmet":"^8.0.0","react":"^19.3.1","react-dom":"^19.3.1"},"devDependencies":{"concurrently":"^10.0.6","supertest":"^7.0.0","vite":"^8.3.5","wrangler":"^4.47.0"}}